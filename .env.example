# Supabase — veja README.md para instruções de setup
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos links de redefinição de senha e nos convites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook da Kiwify — veja src/app/api/webhooks/kiwify/route.ts
KIWIFY_WEBHOOK_SECRET=

# Link de checkout do produto na Kiwify — usado no botão "Liberar acesso
# completo" que aparece depois do Avaliar (gratuito) para quem ainda não pagou.
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=

# Meta Pixel (Facebook/Instagram Ads) — ID numérico do Pixel criado no
# Gerenciador de Eventos da Meta. Sem essa variável, o Pixel simplesmente
# não é injetado (nenhum erro). Dispara PageView em toda página e
# InitiateCheckout quando clicam no botão de comprar na página de vendas.
NEXT_PUBLIC_META_PIXEL_ID=
